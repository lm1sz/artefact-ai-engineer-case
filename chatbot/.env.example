# Copy to chatbot/.env locally. Never commit the actual key.
LLM_PROVIDER=openai
OPENAI_API_KEY=
# Used only when LLM_PROVIDER=openai.
OPENAI_MODEL=gpt-6.1-sol
# Supported: low, medium, high, xhigh, max. Empty uses the model default.
OPENAI_REASONING_EFFORT=medium
# To test GPT-OSS 120B via Groq, set LLM_PROVIDER=groq and fill this key.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_REASONING_EFFORT=medium
# Optional absolute directory containing the CSV files and policy PDF.
EMPORIO_DATA_DIR=
